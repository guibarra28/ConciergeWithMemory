OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional, defaults to 30
OPENAI_TIMEOUT_SECONDS=30
# Optional. Password for the fictional demo accounts, set when the database is first created.
DEMO_PASSWORD=concierge-demo
# Optional. SQLite file location, defaults to data/concierge.db
DB_PATH=data/concierge.db
